@model int
<form method="post" enctype="multipart/form-data">

    <input type="hidden" name="UserId" value="@Model" />

    <div class="mb-3">
        <label for="name" class="form-label">Title</label>
        <input type="text"
               class="form-control"
               id="name"
               name="Name"
               placeholder="Enter todo title">
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control"
                  id="description"
                  name="Description"
                  rows="4"
                  placeholder="Enter todo description"></textarea>
    </div>

    <div class="mb-3">
        <label for="deadline" class="form-label">Deadline</label>
        <input type="datetime-local"
               class="form-control"
               id="deadline"
               name="Deadline">
    </div>

    <div class="mb-4">
        <label for="file" class="form-label">Attachment</label>
        <input type="file"
               class="form-control"
               id="file"
               name="File"
               accept=".pdf"
        >
    </div>

    <button type="submit" class="btn btn-primary">
        Create Todo
    </button>

    <a href="#" class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <script>
        // 1. Get current date and time
        const now = new Date();

        // 2. Add 1 hour to it
        now.setHours(now.getHours() + 1);

        // 3. Format it to match HTML datetime-local format (YYYY-MM-DDTHH:mm)
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const day = String(now.getDate()).padStart(2, '0');
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');

        const minDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;

        // 4. Set the 'min' attribute on the input
        document.getElementById('deadline').min = minDateTime;
    </script>
}